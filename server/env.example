# Şirket Bilgileri
COMPANY_NAME=Marka World
COMPANY_ADDRESS=Karşıyaka Mah. Vali Ayhan Çevik Bulvarı 46/A, Merkez/TOKAT
COMPANY_TAX_NO=0012587682

# Admin (zorunlu)
# ADMIN_PASSWORD düz metin KULLANILMAZ. bcrypt hash üretin:
#   cd server && node -e "require('bcrypt').hash('GucluSifreniz',12).then(console.log)"
# veya: bash scripts/reset-admin-password.sh "GucluSifreniz"
ADMIN_USERNAME=markaworld
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_BCRYPT_HASH_FROM_RESET_SCRIPT

# JWT (zorunlu — rastgele uzun bir anahtar)
JWT_SECRET=uzun-rastgele-gizli-anahtar

# E-posta — SMTP (önerilen, kalıcı)
EMAIL_DRIVER=smtp
EMAIL_HOST=mail.markaworld.com.tr
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=info@markaworld.com.tr
EMAIL_PASS=eposta-sifreniz
EMAIL_FROM=Marka World <info@markaworld.com.tr>

# E-posta — Gmail OAuth (yedek; Google test modunda ~7 günde düşebilir)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_USER=

# Sunucu
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://markaworld.com.tr
